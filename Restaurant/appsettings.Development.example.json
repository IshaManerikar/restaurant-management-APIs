{
  "ConnectionStrings": {
    "RestaurantDBConnection": "Server=localhost;Port=3306;Database=your_dbName;Uid=Your _username;Pwd=Your_Password;SslMode=None;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsost": "LogEventLevel.Warning",
        "MicrosoftEntityFrameworkCore": "LogEventLevel.Information"

      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:dd-MM HH:mm:ss} {Level:u3}] {Message:lj}{NewLine} |{SourceContext}|{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Api-logs-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true

        }
      }
    ]
    
  }
}
